# 本地密钥模板 —— 复制为 .env.local 后填入真实值,或直接用环境变量。
#
# 为什么 .env 里不放真 key:这个仓库会被打包、分享、推到公开托管平台,
# 任何写进受版本控制文件的密钥都应视为已泄露。真实密钥只走:
#   1) 进程环境变量 DEEPSEEK_API_KEY
#   2) 本地 .env.local(gitignored,不随仓库分发)
#   3) 用 CITECHECK_ENV_FILE 指向仓库外的任意 .env
#
# 一旦真实密钥曾出现在文件里,请到控制台轮换(重置)它,而不只是删掉。

# --- LLM 判官(可选,缺省时 --mode llm 会明确报错并提示降级) -------------
DEEPSEEK_API_KEY=sk-your-key-here

# 成本硬顶(人民币)。到顶抛 BudgetStop,防止批量跑测试时超支。
CITECHECK_CAP=12

# --- 向量检索通道(可选,--retriever hybrid|dense 时使用) ----------------
# 任意 OpenAI 兼容 /embeddings 端点;离线可用 --embedder hashing 代替。
CITECHECK_EMBED_KEY=
CITECHECK_EMBED_BASE_URL=https://api.openai.com/v1
